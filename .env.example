# ScholarSwarm AI Environment Configuration (Template)
# Copy this file to .env and configure local development values.
# NEVER commit your actual .env file or real API keys to version control.

# Application Configuration
APP_ENV=development
APP_PORT=8000
APP_HOST=127.0.0.1
DEBUG=True

# Database Configuration
DATABASE_URL=sqlite:///./scholarswarm.db

# LLM Provider Configuration (Verified at runtime in later milestones)
# Supported: gemini, openai
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
LLM_API_KEY=

# Search Provider Configuration (Verified at runtime in later milestones)
# Supported: tavily, serper
SEARCH_PROVIDER=tavily
SEARCH_API_KEY=

# GitHub API Configuration (Optional: unauthenticated access works with lower rate limit)
GITHUB_TOKEN=

# Session and Pipeline Configuration
SESSION_RETENTION_HOURS=24
SCORING_WEIGHTS_FILE=config/scoring_weights.json
